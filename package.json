{
  "name": "comicsanscon-chat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SPA para chatear con personajes ficticios usando Google Gemini a través de Vercel Serverless Functions",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file-if-exists=.env scripts/api-server.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.5.2",
    "@vitest/coverage-v8": "^2.1.8",
    "jsdom": "^24.1.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  }
}
