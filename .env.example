# Clave de Google AI Studio (https://aistudio.google.com/app/apikey).
# Solo la lee la serverless function; nunca llega al navegador.
GEMINI_API_KEY=

# Opcional. Modelos de Gemini a utilizar, separados por coma y en orden de preferencia.
# Si el primero no arranca en 3,5 s, agota su cuota (429) o no está disponible (503/404),
# se lanza el siguiente y gana el que responda primero.
# Por defecto: gemini-3.1-flash-lite,gemini-3-flash-preview (ordenados por latencia medida).
GEMINI_MODEL=

# Opcional. Puerto del servidor local de la API (npm run dev:api). Por defecto: 3000.
API_PORT=
